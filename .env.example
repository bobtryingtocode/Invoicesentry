# Anthropic — for AI-written reminder emails
ANTHROPIC_API_KEY=sk-ant-...

# Stripe — server-side keys (used by /api/stripe/* routes)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (from dashboard.stripe.com/products) for the Pricing modal
STRIPE_PRO_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...

# Public app URL — used as success/cancel return URL for Stripe Checkout
# Vercel sets this automatically; locally use http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
